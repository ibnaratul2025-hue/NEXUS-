root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{xml,json,yml,yaml}]
indent_size = 2
indent_style = space

[*.{c,cpp,h,hpp}]
indent_size = 4
indent_style = space

[*.sh]
indent_size = 2
indent_style = space
end_of_line = lf

[*.bat]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
max_line_length = off
